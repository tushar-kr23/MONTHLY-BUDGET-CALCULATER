rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles Collection: users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // 2. Monthly Budget Subcollection: users/{userId}/months/{monthKey}
      match /months/{monthKey} {
        allow read: if isOwner(userId);
        
        // Ensure budget is a non-negative number
        allow create, update: if isOwner(userId) &&
          request.resource.data.budget is number &&
          request.resource.data.budget >= 0;

        allow delete: if isOwner(userId);

        // 3. Expenses Subcollection: users/{userId}/months/{monthKey}/expenses/{expenseId}
        match /expenses/{expenseId} {
          allow read: if isOwner(userId);

          // Validate required fields, positive amount, and proper data types
          allow create, update: if isOwner(userId) &&
            request.resource.data.title is string &&
            request.resource.data.title.size() > 0 &&
            request.resource.data.amount is number &&
            request.resource.data.amount > 0 &&
            request.resource.data.category is string &&
            request.resource.data.date is string;

          allow delete: if isOwner(userId);
        }
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}